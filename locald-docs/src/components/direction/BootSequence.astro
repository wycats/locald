---
/*
 * BootSequence — the "$ locald up" terminal panel from the Public Site
 * Direction poster (page 04, top-right). A terminal-style panel with a command
 * header, a checklist of green-check boot steps, and (below the panel) an arrow
 * pointing to the first ready URL.
 *
 * AUTHORITATIVE SOURCE: .private/style/guide-4-direction.png. Domains use
 * *.localhost (written-guide rule), not the poster's .test.
 */

interface Props {
  command?: string;
  steps?: string[];
  readyUrl?: string;
  class?: string;
}

const {
  command = "$ locald up",
  steps = [
    "Bringing services online...",
    "Provisioning HTTPS...",
    "Registering local domains...",
    "All systems go.",
  ],
  readyUrl = "https://web.localhost",
  class: className,
} = Astro.props;
---

<div class:list={["locald-boot", className]}>
  <div class="locald-boot__cmd">{command}</div>

  <ul class="locald-boot__steps">
    {
      steps.map((step) => (
        <li class="locald-boot__step">
          <span class="locald-boot__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <circle
                cx="7"
                cy="7"
                r="6"
                stroke="var(--locald-status-running)"
                stroke-width="1"
              />
              <path
                d="M4 7 6.2 9.2 10 5"
                stroke="var(--locald-status-running)"
                stroke-width="1.25"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="locald-boot__step-text">{step}</span>
        </li>
      ))
    }
  </ul>

  <div class="locald-boot__ready">
    <span class="locald-boot__arrow" aria-hidden="true">&rarr;</span>
    <span class="locald-boot__url">{readyUrl}</span>
  </div>
</div>

<style>
  .locald-boot {
    border: 1px solid var(--locald-border-strong);
    border-radius: var(--locald-radius-lg);
    background: var(--locald-surface-1);
    padding: var(--locald-space-3);
    display: flex;
    flex-direction: column;
    gap: var(--locald-space-3);
  }

  .locald-boot__cmd {
    font-family: var(--locald-font-mono);
    font-size: 0.95rem;
    color: var(--locald-text-primary);
  }

  .locald-boot__steps {
    list-style: none;
    margin: 0;
    padding: var(--locald-space-2);
    display: flex;
    flex-direction: column;
    gap: var(--locald-gap-md);
    border: 1px solid var(--locald-border-subtle);
    border-radius: var(--locald-radius-md);
    background: var(--locald-surface-2);
  }

  .locald-boot__step {
    display: flex;
    align-items: center;
    gap: var(--locald-gap-sm);
    font-family: var(--locald-font-mono);
    font-size: var(--locald-type-caption-size);
    color: var(--locald-text-secondary);
  }

  .locald-boot__check {
    flex: none;
    display: inline-flex;
  }

  .locald-boot__ready {
    display: flex;
    align-items: center;
    gap: var(--locald-gap-md);
    font-family: var(--locald-font-mono);
    font-size: var(--locald-type-caption-size);
  }

  .locald-boot__arrow {
    color: var(--locald-status-running);
  }

  .locald-boot__url {
    color: var(--locald-status-running);
  }
</style>
