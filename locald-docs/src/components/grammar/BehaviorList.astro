---
/*
 * BehaviorList — the "BEHAVIOR" column from the Product Surface Grammar poster
 * (page 03, third band, right). A lead statement followed by green-check items
 * describing guaranteed product behaviors.
 *
 * AUTHORITATIVE SOURCE: .private/style/guide-3-grammar.png.
 */

interface Props {
  lead?: string;
  items?: string[];
  class?: string;
}

const {
  lead = "Services are first-class and persistent.",
  items = [
    "Stable names across restarts.",
    "Deterministic local URLs.",
    "Built-in observability (logs, metrics, events).",
    "Pinned focus that survives navigation.",
  ],
  class: className,
} = Astro.props;
---

<div class:list={["locald-behavior", className]}>
  <p class="locald-behavior__lead">{lead}</p>
  <ul class="locald-behavior__list">
    {
      items.map((item) => (
        <li class="locald-behavior__item">
          <span class="locald-behavior__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path
                d="M3 7.5 6 10.5 11 4"
                stroke="var(--locald-status-running)"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="locald-behavior__text">{item}</span>
        </li>
      ))
    }
  </ul>

  <div class="locald-behavior__glyph" aria-hidden="true">
    <svg width="120" height="64" viewBox="0 0 120 64" fill="none">
      <g
        stroke="var(--locald-border-strong)"
        stroke-width="1.25"
        stroke-dasharray="3 3"
      >
        <line x1="60" y1="32" x2="22" y2="14" />
        <line x1="60" y1="32" x2="98" y2="14" />
        <line x1="60" y1="32" x2="18" y2="50" />
        <line x1="60" y1="32" x2="102" y2="50" />
      </g>
      <polygon
        points="60,22 69,27 69,37 60,42 51,37 51,27"
        fill="none"
        stroke="var(--locald-stroke-route)"
        stroke-width="1.5"
      />
      <g fill="none" stroke="var(--locald-border-strong)" stroke-width="1.25">
        <rect x="16" y="8" width="12" height="12" rx="2" />
        <rect x="92" y="8" width="12" height="12" rx="2" />
        <rect x="12" y="44" width="12" height="12" rx="2" />
        <rect x="96" y="44" width="12" height="12" rx="2" />
      </g>
    </svg>
  </div>
</div>

<style>
  .locald-behavior {
    display: flex;
    flex-direction: column;
    gap: var(--locald-space-2);
    height: 100%;
  }

  .locald-behavior__lead {
    margin: 0;
    font-family: var(--locald-font-sans);
    font-size: 1rem;
    color: var(--locald-text-primary);
  }

  .locald-behavior__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--locald-gap-md);
  }

  .locald-behavior__item {
    display: flex;
    align-items: center;
    gap: var(--locald-gap-sm);
    font-family: var(--locald-font-mono);
    font-size: var(--locald-type-caption-size);
    color: var(--locald-text-secondary);
  }

  .locald-behavior__check {
    flex: none;
    display: inline-flex;
  }

  /* Topology glyph: fills the remaining card height, anchored to the bottom. */
  .locald-behavior__glyph {
    margin-top: auto;
    padding-top: var(--locald-space-2);
    display: flex;
    justify-content: center;
  }
</style>
